{
  "name": "Riggu Control",
  "image": "taruntom/riggu_devcontainer",
  "runArgs": [
    "--privileged",
    "--network=host",
    "--device=/dev/ttyUSB0",
    "--device=/dev/video0",
    
  ],
  "containerEnv": {
    // Remove software rendering, use actual GPU
    "LIBGL_ALWAYS_SOFTWARE":"1"  // Remove this line
    //"ROC_ENABLE_PRE_VEGA": "1"  // Enable older AMD GPU support if needed
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/${localWorkspaceFolderBasename},type=bind",
  "workspaceFolder": "/${localWorkspaceFolderBasename}",
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.bash_history,target=/home/vscode/.bash_history,type=bind",
    "source=${localEnv:HOME}/.ccache,target=/home/vscode/.ccache,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "visualstudioexptteam.vscodeintellicode",
        "ms-python.python",
        "ms-python.debugpy",
        "ms-python.vscode-pylance",
        "ranch-hand-robotics.rde-pack",
        "yzhang.markdown-all-in-one"
      ]
    }
  },
  "postStartCommand": "/start_zenoh.sh"
}
