# riggu base bring-up on boot: ros2_control + DriveLink (disarmed), lidar, collision
# monitor, twist_mux, pad teleop and pad arming. Installed by scripts/setup_local.sh,
# which replaces @USER@ and @WS@. Extra launch args: RIGGU_BRINGUP_ARGS in
# /etc/default/riggu-base (e.g. imu:=false without the BNO055, use_imu_orientation:=false).
[Unit]
Description=riggu base bring-up
Wants=rmw-zenohd.service drivelink-agent.service bluetooth.service network-online.target
After=rmw-zenohd.service drivelink-agent.service bluetooth.service network-online.target

[Service]
Type=simple
User=@USER@
Environment=RIGGU_BRINGUP_ARGS=
EnvironmentFile=-/etc/default/riggu-base
ExecStart=/bin/bash -c 'source @WS@/scripts/env.sh robot && exec ros2 launch riggu_bringup bringup.launch.py mode:=real $RIGGU_BRINGUP_ARGS'
KillSignal=SIGINT
TimeoutStopSec=20
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
