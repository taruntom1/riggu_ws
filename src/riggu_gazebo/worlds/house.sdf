<?xml version="1.0"?>
<!--
  riggu default indoor world: a 10 x 8 m single-storey house, static primitives only.
  Rooms: living (SE, robot spawn at 2.5 -1.5), kitchen (NE), bedroom (NW), office (SW).
  Doorways 1.0 m wide; walls 1.0 m tall (above the lidar plane).
  Furniture is static boxes and cylinders (seen by the 2D lidar as solid).
-->
<sdf version="1.9">
  <world name="house">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1.0</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="walls">
      <static>true</static>
      <link name="outer_s">
        <pose>0 -4 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10.1 0.1 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.1 0.1 1.0</size></box></geometry><material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.85 0.83 0.78 1</diffuse></material></visual>
      </link>
      <link name="outer_n">
        <pose>0 4 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10.1 0.1 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.1 0.1 1.0</size></box></geometry><material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.85 0.83 0.78 1</diffuse></material></visual>
      </link>
      <link name="outer_w">
        <pose>-5 0 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 8.1 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 8.1 1.0</size></box></geometry><material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.85 0.83 0.78 1</diffuse></material></visual>
      </link>
      <link name="outer_e">
        <pose>5 0 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 8.1 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 8.1 1.0</size></box></geometry><material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.85 0.83 0.78 1</diffuse></material></visual>
      </link>
      <link name="mid_1">
        <pose>0 -3.25 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 1.6 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 1.6 1.0</size></box></geometry><material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.85 0.83 0.78 1</diffuse></material></visual>
      </link>
      <link name="mid_2">
        <pose>0 0 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 3.1 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 3.1 1.0</size></box></geometry><material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.85 0.83 0.78 1</diffuse></material></visual>
      </link>
      <link name="mid_3">
        <pose>0 3.25 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.1 1.6 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 1.6 1.0</size></box></geometry><material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.85 0.83 0.78 1</diffuse></material></visual>
      </link>
      <link name="west_1">
        <pose>-4 0 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.1 0.1 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.1 0.1 1.0</size></box></geometry><material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.85 0.83 0.78 1</diffuse></material></visual>
      </link>
      <link name="west_2">
        <pose>-1 0 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.1 0.1 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.1 0.1 1.0</size></box></geometry><material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.85 0.83 0.78 1</diffuse></material></visual>
      </link>
      <link name="east_1">
        <pose>0.75 1 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.6 0.1 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.6 0.1 1.0</size></box></geometry><material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.85 0.83 0.78 1</diffuse></material></visual>
      </link>
      <link name="east_2">
        <pose>3.75 1 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.6 0.1 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.6 0.1 1.0</size></box></geometry><material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.85 0.83 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <model name="furniture">
      <static>true</static>
      <link name="sofa">
        <pose>2.5 -3.5 0.225 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.0 0.8 0.45</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 0.8 0.45</size></box></geometry><material><ambient>0.55 0.4 0.28 1</ambient><diffuse>0.55 0.4 0.28 1</diffuse></material></visual>
      </link>
      <link name="coffee_table">
        <pose>2.5 -2.6 0.2 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.0 0.5 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 0.5 0.4</size></box></geometry><material><ambient>0.55 0.4 0.28 1</ambient><diffuse>0.55 0.4 0.28 1</diffuse></material></visual>
      </link>
      <link name="tv_stand">
        <pose>4.75 -1.5 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.4 1.4 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 1.4 0.5</size></box></geometry><material><ambient>0.55 0.4 0.28 1</ambient><diffuse>0.55 0.4 0.28 1</diffuse></material></visual>
      </link>
      <link name="plant">
        <pose>4.6 0.6 0.4 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.2</radius><length>0.8</length></cylinder></geometry><material><ambient>0.55 0.4 0.28 1</ambient><diffuse>0.55 0.4 0.28 1</diffuse></material></visual>
      </link>
      <link name="counter">
        <pose>3.25 3.65 0.45 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3.3 0.6 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.3 0.6 0.9</size></box></geometry><material><ambient>0.55 0.4 0.28 1</ambient><diffuse>0.55 0.4 0.28 1</diffuse></material></visual>
      </link>
      <link name="island">
        <pose>3.4 2.3 0.45 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.2 0.8 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.8 0.9</size></box></geometry><material><ambient>0.55 0.4 0.28 1</ambient><diffuse>0.55 0.4 0.28 1</diffuse></material></visual>
      </link>
      <link name="stool_1">
        <pose>2.55 2.1 0.325 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.18</radius><length>0.65</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.18</radius><length>0.65</length></cylinder></geometry><material><ambient>0.55 0.4 0.28 1</ambient><diffuse>0.55 0.4 0.28 1</diffuse></material></visual>
      </link>
      <link name="stool_2">
        <pose>2.55 2.6 0.325 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.18</radius><length>0.65</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.18</radius><length>0.65</length></cylinder></geometry><material><ambient>0.55 0.4 0.28 1</ambient><diffuse>0.55 0.4 0.28 1</diffuse></material></visual>
      </link>
      <link name="fridge">
        <pose>4.6 1.5 0.9 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.7 0.7 1.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 0.7 1.8</size></box></geometry><material><ambient>0.55 0.4 0.28 1</ambient><diffuse>0.55 0.4 0.28 1</diffuse></material></visual>
      </link>
      <link name="bed">
        <pose>-3.95 2.95 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.0 1.6 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 1.6 0.5</size></box></geometry><material><ambient>0.55 0.4 0.28 1</ambient><diffuse>0.55 0.4 0.28 1</diffuse></material></visual>
      </link>
      <link name="nightstand">
        <pose>-4.7 1.8 0.275 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.45 0.45 0.55</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 0.45 0.55</size></box></geometry><material><ambient>0.55 0.4 0.28 1</ambient><diffuse>0.55 0.4 0.28 1</diffuse></material></visual>
      </link>
      <link name="wardrobe">
        <pose>-0.35 3.3 0.95 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.6 1.2 1.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 1.2 1.9</size></box></geometry><material><ambient>0.55 0.4 0.28 1</ambient><diffuse>0.55 0.4 0.28 1</diffuse></material></visual>
      </link>
      <link name="desk">
        <pose>-4.6 -2 0.375 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.7 1.4 0.75</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 1.4 0.75</size></box></geometry><material><ambient>0.55 0.4 0.28 1</ambient><diffuse>0.55 0.4 0.28 1</diffuse></material></visual>
      </link>
      <link name="office_chair">
        <pose>-3.9 -2 0.45 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.9</length></cylinder></geometry><material><ambient>0.55 0.4 0.28 1</ambient><diffuse>0.55 0.4 0.28 1</diffuse></material></visual>
      </link>
      <link name="bookshelf">
        <pose>-1.5 -3.775 0.9 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.2 0.35 1.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.35 1.8</size></box></geometry><material><ambient>0.55 0.4 0.28 1</ambient><diffuse>0.55 0.4 0.28 1</diffuse></material></visual>
      </link>
      <link name="bin">
        <pose>-0.4 -0.4 0.2 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry><material><ambient>0.55 0.4 0.28 1</ambient><diffuse>0.55 0.4 0.28 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
