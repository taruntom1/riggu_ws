<?xml version="1.0"?>
<!--
  riggu robot description.
    mode:=real|sim|mock        ros2_control hardware (see ros2_control.xacro)
    robot_config:=<path>       dimensions file (default config/robot.yaml)
    controllers_file:=<path>   sim only: controller params for gz_ros2_control
    drivelink_*                real only: DriveLink agent connection and labels
-->
<robot name="riggu" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="mode" default="mock"/>
  <xacro:arg name="robot_config" default="$(find riggu_description)/config/robot.yaml"/>
  <xacro:arg name="controllers_file" default=""/>
  <xacro:arg name="drivelink_agent" default="tcp://127.0.0.1:47620"/>
  <xacro:arg name="drivelink_device" default="base"/>
  <xacro:arg name="drivelink_token_file" default="/etc/drivelink/token"/>
  <xacro:arg name="drivelink_token" default=""/>
  <xacro:arg name="drivelink_left_label" default="pid_left"/>
  <xacro:arg name="drivelink_right_label" default="pid_right"/>
  <xacro:arg name="drivelink_imu_label" default="imu"/>

  <xacro:property name="mode" value="$(arg mode)"/>
  <xacro:property name="robot_config" value="$(arg robot_config)"/>
  <xacro:property name="controllers_file" value="$(arg controllers_file)"/>
  <xacro:unless value="${mode in ['real', 'sim', 'mock']}">
    <!-- Fails xacro with this name in the error message -->
    ${mode_must_be_real_sim_or_mock}
  </xacro:unless>

  <xacro:include filename="properties.xacro"/>
  <xacro:include filename="inertial.xacro"/>
  <xacro:include filename="base.xacro"/>
  <xacro:include filename="sensors.xacro"/>
  <xacro:include filename="ros2_control.xacro"/>
</robot>
