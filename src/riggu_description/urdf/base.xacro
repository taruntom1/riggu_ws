<?xml version="1.0"?>
<!-- base_footprint, base_link (chassis), drive wheels, rear caster. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="chassis_grey"><color rgba="0.35 0.35 0.38 1"/></material>
  <material name="wheel_black"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="caster_white"><color rgba="0.9 0.9 0.9 1"/></material>

  <!-- REP-105: base_footprint on the floor, base_link on the axle midpoint -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${axle_height}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="${chassis_x} 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="${chassis_x} 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
      <origin xyz="${chassis_x} 0 ${chassis_z}" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!--
    Both wheel joints rotate about +y of base_link (rpy -pi/2 maps the
    cylinder's z onto +y), so a positive velocity drives the robot forward.
  -->
  <xacro:macro name="drive_wheel" params="side y">
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel"/>
      <origin xyz="0 ${y} 0" rpy="${-pi / 2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="${side}_wheel">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:inertial_cylinder mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <xacro:if value="${mode == 'sim'}">
      <gazebo reference="${side}_wheel">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
      </gazebo>
    </xacro:if>
  </xacro:macro>

  <xacro:drive_wheel side="left" y="${wheel_y}"/>
  <xacro:drive_wheel side="right" y="${-wheel_y}"/>

  <!-- Ball caster: a fixed, near-frictionless sphere -->
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="${caster_x} 0 ${caster_z}" rpy="0 0 0"/>
  </joint>

  <link name="caster">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="caster_white"/>
    </visual>
    <xacro:if value="${caster_post_length > 0}">
      <visual>
        <origin xyz="0 0 ${caster_radius + caster_post_length / 2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${caster_radius * 0.6}" length="${caster_post_length}"/></geometry>
        <material name="caster_white"/>
      </visual>
    </xacro:if>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <xacro:inertial_sphere mass="${caster_mass}" radius="${caster_radius}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_sphere>
  </link>

  <xacro:if value="${mode == 'sim'}">
    <gazebo reference="caster">
      <mu1>0.001</mu1>
      <mu2>0.001</mu2>
    </gazebo>
  </xacro:if>
</robot>
