<?xml version="1.0"?>
<!--
  ros2_control hardware by mode. All three expose the same interfaces:
    left_wheel_joint, right_wheel_joint: command velocity; state position, velocity
    sensor imu (frame imu_link): orientation.*, angular_velocity.*, linear_acceleration.*
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="imu_interfaces"
                  value="${['orientation.x', 'orientation.y', 'orientation.z', 'orientation.w',
                           'angular_velocity.x', 'angular_velocity.y', 'angular_velocity.z',
                           'linear_acceleration.x', 'linear_acceleration.y', 'linear_acceleration.z']}"/>

  <xacro:macro name="generic_wheel" params="joint">
    <joint name="${joint}">
      <command_interface name="velocity"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
    </joint>
  </xacro:macro>

  <xacro:macro name="generic_imu_interfaces" params="names">
    <xacro:if value="${names}">
      <state_interface name="${names[0]}">
        <param name="initial_value">${1.0 if names[0] == 'orientation.w' else 0.0}</param>
      </state_interface>
      <xacro:generic_imu_interfaces names="${names[1:]}"/>
    </xacro:if>
  </xacro:macro>

  <!-- real: DriveLink (macro and plugin owned by drivelink_bringup) -->
  <xacro:if value="${mode == 'real'}">
    <xacro:include filename="$(find drivelink_bringup)/urdf/drivelink.ros2_control.xacro"/>
    <xacro:drivelink_diff_drive
      name="drivelink"
      agent="$(arg drivelink_agent)"
      device="$(arg drivelink_device)"
      token_file="$(arg drivelink_token_file)"
      token="$(arg drivelink_token)"
      left_joint="left_wheel_joint" left_label="$(arg drivelink_left_label)"
      right_joint="right_wheel_joint" right_label="$(arg drivelink_right_label)"
      imu_label="$(arg drivelink_imu_label)"/>
  </xacro:if>

  <!-- sim: Gazebo Harmonic -->
  <xacro:if value="${mode == 'sim'}">
    <ros2_control name="gazebo" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <xacro:generic_wheel joint="left_wheel_joint"/>
      <xacro:generic_wheel joint="right_wheel_joint"/>
      <sensor name="imu">
        <xacro:generic_imu_interfaces names="${imu_interfaces}"/>
      </sensor>
    </ros2_control>

    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <xacro:if value="${controllers_file != ''}">
          <parameters>${controllers_file}</parameters>
        </xacro:if>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- mock: CI and desk tests; position integrates the commanded velocity -->
  <xacro:if value="${mode == 'mock'}">
    <ros2_control name="mock" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <param name="calculate_dynamics">true</param>
      </hardware>
      <xacro:generic_wheel joint="left_wheel_joint"/>
      <xacro:generic_wheel joint="right_wheel_joint"/>
      <sensor name="imu">
        <xacro:generic_imu_interfaces names="${imu_interfaces}"/>
      </sensor>
    </ros2_control>
  </xacro:if>
</robot>
